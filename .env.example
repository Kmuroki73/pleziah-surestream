# Browser-safe Supabase values only. Never put service-role keys in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Cloudflare Turnstile public site key (the secret key belongs in Supabase Auth settings).
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-side payment configuration only. Keep all secrets in Cloudflare Pages/Workers secrets.
PAYMENT_PROVIDER=YOUR_APPROVED_PROVIDER
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://foreignlovee.com/payment/success
PAYMENT_CANCEL_URL=https://foreignlovee.com/payment/cancel

# Server-only Supabase service-role key. Never prefix with VITE_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
