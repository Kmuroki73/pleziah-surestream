# Browser-safe Supabase project values. Never put service-role keys in VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only football data provider. Configure in Vercel Project Settings.
SPORTMONKS_API_KEY=

# Server-only SportSRC key. Rotate any key that was pasted into chat or committed.
SPORTSRC_API_KEY=

# Optional fallback provider
FOOTBALL_DATA_API_KEY=

# RapidAPI — server-side only. Fill these from the subscribed API's Endpoints page.
# Never prefix secrets with VITE_ and never commit a real key.
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_BASE_URL=
RAPIDAPI_ENDPOINT=
